// TonyAI — Prisma schema (Milestone 1 vertical slice)
// Tables live in the Postgres `public` schema; Supabase Auth owns `auth.users`.
// Profile.id mirrors auth.users.id (no cross-schema FK in Prisma).

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
  // Container targets: debian (amd64) + arm64 for Apple-Silicon local builds.
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  super_admin
  consultant
  data_entry
  executive_viewer
}

enum SubsidiaryStatus {
  active
  inactive
  pending
}

/// How completeness is measured for a subsidiary (WP17 / round-1 DE-2 + DASH-3).
///
/// `subsidiary` — the historic behaviour: a category is complete once it holds a
/// committed record with its evidence, whatever the entity that record names.
/// `location`  — the invoice rule: each invoice-tracked category needs one
/// monthly invoice per LOCATION, so the denominator is `locations × 12`.
///
/// An explicit setting rather than an inference. Measured before choosing: 96 of
/// the 102 seeded records carry no `location_id` at all, so a rule that switched
/// itself on whenever a subsidiary happens to own locations would report almost
/// every existing tenant as incomplete overnight, and would leave the user with
/// no way to see WHY. Defaulting to `subsidiary` keeps every existing dashboard
/// exactly as it was; a super_admin will opt a subsidiary in when its data is
/// actually keyed by location (API: PATCH /subsidiaries/:id — the UI arrives
/// with the coverage display in WP17 PR 3).
enum TrackingGranularity {
  subsidiary
  location
}

enum ActivityRecordStatus {
  draft
  submitted
  under_review
  approved
  rejected
  locked
  // An approved figure withdrawn from the inventory, with a mandatory reason,
  // WITHOUT deleting it. Before this, `approved` had no exit at all: the only
  // remedy was deleting the row, which the API rightly refuses and which would
  // destroy the figure a reviewer accepted. A voided record still exists, is
  // still auditable, and counts towards nothing.
  //
  // This carries the four elements FR §4.3 lists for a revision entry
  // (mandatory comment, user reference, timestamp, original-value visibility)
  // but it does NOT implement §4.3, which governs LOCKED records — those are
  // refused here and still reopen only by unlocking the period. §4.3 also asks
  // for a revision ENTRY linked to what it corrects; there is no such link yet,
  // so a restatement is two unrelated rows.
  voided
}

model Profile {
  id               String                 @id @db.Uuid // = auth.users.id
  email            String                 @unique
  fullName         String                 @map("full_name")
  role             UserRole               @default(data_entry)
  /// A `SUPPORTED_LOCALES` entry (CHECK `profiles_language_supported`, LP3-01);
  /// the user sets their own through PATCH /me/preferences.
  language         String                 @default("en")
  theme            String                 @default("light")
  organisationId   String?                @map("organisation_id") @db.Uuid
  organisation     Organisation?          @relation(fields: [organisationId], references: [id])
  subsidiaryAccess UserSubsidiaryAccess[]
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  // The target of `user_subsidiary_access`'s composite foreign key (LP1-03):
  // `id` alone is already unique; the pair is what lets the database refuse a
  // grant between a profile and a subsidiary of different organisations.
  @@unique([id, organisationId])
  @@map("profiles")
}

model Organisation {
  id                String       @id @default(uuid()) @db.Uuid
  legalName         String       @map("legal_name")
  tradingName       String?      @map("trading_name")
  country           String
  geographyCode     String       @map("geography_code")
  sector            String?
  reportingCurrency String       @default("EUR") @map("reporting_currency")
  subsidiaries      Subsidiary[]
  profiles          Profile[]
  importBatches     ImportBatch[]
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  @@map("organisations")
}

model Subsidiary {
  id               String                 @id @default(uuid()) @db.Uuid
  organisationId   String                 @map("organisation_id") @db.Uuid
  organisation     Organisation           @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  legalName        String                 @map("legal_name")
  tradingName      String?                @map("trading_name")
  location         String?
  geographyCode    String                 @map("geography_code")
  businessArea     String?                @map("business_area")
  sector           String?
  // Who to contact about this entity's reporting (round-1 UAT SUB-2). Nullable:
  // every existing row predates them, and a subsidiary is legally identifiable
  // without them. `designatedPerson` is the NAME and already existed — it is
  // rendered read-only as "responsible" in the tracking matrix — but until WP16
  // nothing could write it, so all five seeded rows say "Seed Admin".
  designatedPerson String?                @map("designated_person")
  contactEmail     String?                @map("contact_email")
  contactPhone     String?                @map("contact_phone")
  reportingStatus  SubsidiaryStatus       @default(pending) @map("reporting_status")
  includedScopes   Int[]                  @default([1, 2]) @map("included_scopes")
  // Defaults to `subsidiary` so no existing row changes meaning. Both write
  // paths refuse `location` without at least one location: the denominator
  // would be `0 × 12 = 0`, every slot is then vacuously covered, and a
  // subsidiary holding one stray record would read as complete.
  trackingGranularity TrackingGranularity @default(subsidiary) @map("tracking_granularity")
  locations        Location[]
  access           UserSubsidiaryAccess[]
  activityRecords  ActivityRecord[]
  periodLocks      PeriodLock[]
  targets          Target[]
  denominators     SubsidiaryDenominator[]
  evidence         Evidence[]
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  @@index([organisationId])
  // The target of `user_subsidiary_access`'s composite foreign key (LP1-03).
  @@unique([id, organisationId])
  @@map("subsidiaries")
}

model Location {
  id               String           @id @default(uuid()) @db.Uuid
  subsidiaryId     String           @map("subsidiary_id") @db.Uuid
  subsidiary       Subsidiary       @relation(fields: [subsidiaryId], references: [id], onDelete: Cascade)
  name             String
  geographyCode    String           @map("geography_code") // drives factor selection for records at this location
  address          String?
  authorizedPerson String?          @map("authorized_person")
  activityRecords  ActivityRecord[]
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  @@index([subsidiaryId])
  @@map("locations")
}

// An activity record is the core data-entry unit: a single activity input for a
// (subsidiary, reporting period, category), plus an IMMUTABLE calculation
// snapshot produced by the calc engine at create/update time (never recomputed
// on read, so historic results survive factor-library changes). It moves through
// a status workflow (draft -> submitted -> under_review -> approved/rejected).
// `approved` is immutable and leaves only by being VOIDED — an audited
// withdrawal that takes a figure out of the inventory with a stated reason
// instead of deleting it. `locked` leaves only by UNLOCKING the period, and a
// void is refused on it: a closed period reopens through its own path or not at
// all. Child of `subsidiaries`, so it is tenant-scoped by `subsidiary_id`.
model ActivityRecord {
  id             String               @id @default(uuid()) @db.Uuid
  subsidiaryId   String               @map("subsidiary_id") @db.Uuid
  subsidiary     Subsidiary           @relation(fields: [subsidiaryId], references: [id], onDelete: Cascade)
  locationId     String?              @map("location_id") @db.Uuid
  location       Location?            @relation(fields: [locationId], references: [id], onDelete: SetNull)
  reportingYear  Int                  @map("reporting_year")
  reportingPeriod String              @map("reporting_period") // 'monthly' | 'quarterly' | 'annual'
  // Canonicalised on write to the vocabulary in @tonyai/shared-types
  // (PERIOD_VALUES): "January".."December" | "Q1".."Q4" | "Annual". Not an
  // example set -- the uniqueness index below compares this column RAW, so a
  // second spelling of one month is a second period.
  periodValue    String               @map("period_value")
  category       String // canonical category key, e.g. "Electricity"
  // The fuel or gas a typed category's record is for (`recordActivityTypesFor`
  // in @tonyai/shared-types: Fuel, Mobile Combustion, Refrigerants); NULL for
  // an implicit category and for a record written before LP3-03. Part of the
  // record's uniqueness slot (the raw index below), so diesel and petrol of one
  // site and month are two records.
  activityType   String?              @map("activity_type")
  scope          Int // derived from CATEGORY_SCOPE_MAP
  status         ActivityRecordStatus @default(draft)
  activityValue  Float                @map("activity_value")
  activityUnit   String               @map("activity_unit")
  input          Json? // raw structured input as submitted (optional)
  calculation    Json // immutable calc-engine snapshot (tCo2e + factor traceability)
  createdBy      String               @map("created_by") @db.Uuid
  anomalyFlag    Boolean              @default(false) @map("anomaly_flag")
  // What the flag above was decided against: how many comparable periods
  // carried a figure, and their rolling average. VAR §4.1 requires three, so a
  // count below it means the rule did NOT run and the average is null --
  // `anomalyFlag: false` said all three of "clean against three", "clean
  // against fewer" and "never evaluated" until these columns existed.
  //
  // THREE states, readable in plain SQL with no join and no JSON parsing:
  //   NULL  -- the pool was never queried (this record carries no figure of its
  //            own, so there is nothing to deviate). It may still sit on a full
  //            year of neighbours; "no figure" and "no priors" are different
  //            facts, and a column that said 0 for both forced every non-
  //            TypeScript reader to re-implement isCalculated() to tell them
  //            apart -- three copies of that predicate already exist.
  //   0..2  -- a short window: the rule did not run.
  //   3     -- evaluated, and `anomalyBaselineTCo2e` is the average it used.
  //
  // Named `anomalyBaseline*` and not `baseline*`: `Target.baselineTCo2e` in
  // this same schema is a reduction target's baseline-year emissions, an
  // unrelated quantity, and one package holding two different "baselines" is a
  // trap for whoever reaches for "the baseline" next.
  //
  // Mutable, unlike `calculation`: a verdict is a judgement about a moving pool
  // of neighbours, not a frozen measurement, which is what makes re-scoring
  // legal at all. Written at create/update/submit beside the flag itself.
  anomalyBaselinePriorCount Int?      @map("anomaly_baseline_prior_count")
  anomalyBaselineTCo2e      Float?    @map("anomaly_baseline_tco2e")
  // The AUTHOR's justification for an anomalous value (VAR §4). A reviewer must
  // never overwrite it — their own words go in reviewNote.
  varianceReason String?              @map("variance_reason")
  // Review outcome: who acted, when, and why (a rejection reason is mandatory).
  reviewedBy     String?              @map("reviewed_by") @db.Uuid
  reviewedAt     DateTime?            @map("reviewed_at")
  reviewNote     String?              @map("review_note")
  // When this record was last SUBMITTED for review — not when its draft was
  // created. The review queue counts a reviewer's waiting time from here.
  // MOST RECENT submit, not the first: a rejected record can be resubmitted, so
  // this answers "how long has the current reviewer had it", matching how
  // `reviewedAt` above is already overwritten on every review outcome. The full
  // history stays in `audit_log`, which holds one `submit` row per attempt.
  // Nullable, and stays null for every record that predates this column: the
  // seed writes records straight to `approved` without ever submitting them, so
  // a backfill finds nothing for them, and back-dating a guess would reinstate
  // exactly the misstatement this column exists to end.
  submittedAt    DateTime?            @map("submitted_at")
  // Who withdrew this figure, when, and why. Separate from
  // `reviewNote` on purpose — that is a reviewer's verdict on data still in the
  // inventory, this is the record of taking data OUT of it, and conflating them
  // would let a rejection reason read as a restatement.
  voidReason     String?              @map("void_reason")
  voidedBy       String?              @map("voided_by") @db.Uuid
  voidedAt       DateTime?            @map("voided_at")
  // The bulk import that created this record, or null for one typed on Data
  // Entry. Written once at create, never by an update. NoAction, not Restrict:
  // a batch cannot be deleted while records point at it, but an organisation
  // delete (which cascades to both) still works, because NO ACTION is checked
  // at the end of the statement.
  importBatchId  String?              @map("import_batch_id") @db.Uuid
  importBatch    ImportBatch?         @relation(fields: [importBatchId], references: [id], onDelete: NoAction)
  evidenceLinks  ActivityRecordEvidence[]
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  // Uniqueness is enforced by a raw NULLS NOT DISTINCT unique index (last
  // defined by the LP3-03 factor-model migration): one live record per
  // (subsidiary, location, year, period, periodValue, category, activityType)
  // — NULL location_id (subsidiary-level) and NULL activity_type (untyped)
  // rows are deduplicated too. Prisma's @@unique can't express NULLS NOT
  // DISTINCT, so it lives in raw SQL like the RLS policies. A slot holds typed
  // records or one untyped record, never both: a trigger in the same
  // migration, since the index cannot see it (NULL ≠ 'diesel').
  @@index([subsidiaryId])
  @@index([locationId])
  // The target of `activity_record_evidence`'s composite foreign key — `id`
  // alone is already unique; the pair is what lets the database refuse a link
  // between a record and a file of different subsidiaries.
  @@unique([id, subsidiaryId])
  @@index([importBatchId])
  @@map("activity_records")
}

enum ImportBatchStatus {
  processing
  completed
  failed
}

// One APPLIED bulk import: the file, who sent it, what it named and what came
// of it. A dry run writes no row — it must provably write nothing. The
// organisation owns the batch (an import can span several of its
// subsidiaries); `uploadedBy` is recorded, with no FK, like `createdBy`.
// `subsidiaryIds` is every entity the FILE names — each subsidiary cell and
// each location's owning subsidiary, all proven accessible at upload — and is
// what the RLS policy and the API scope a data_entry reader by: the source file
// holds every row, refused ones included, so reading it requires reaching all
// of them. Written once at creation; only `status`, the counts and
// `completedAt` change, once, when processing ends. `processing` with null
// counts is an interrupted import — the FK, not the counts, says which records
// it produced. `storagePath` null means the source file is not retained.
model ImportBatch {
  id             String            @id @default(uuid()) @db.Uuid
  organisationId String            @map("organisation_id") @db.Uuid
  organisation   Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  uploadedBy     String            @map("uploaded_by") @db.Uuid
  subsidiaryIds  String[]          @map("subsidiary_ids") @db.Uuid
  fileName       String            @map("file_name")
  fileFormat     String            @map("file_format")
  sizeBytes      Int               @map("size_bytes")
  // Lowercase hex, CHECKed in the database (LP1-02 migration).
  sha256         String            @db.Char(64)
  // Unique: one object backs one batch (LP1-02), so removing an object can
  // never take bytes another row still points at.
  storagePath    String?           @unique @map("storage_path")
  status         ImportBatchStatus @default(processing)
  totalRows      Int               @map("total_rows")
  acceptedCount  Int?              @map("accepted_count")
  rejectedCount  Int?              @map("rejected_count")
  completedAt    DateTime?         @map("completed_at")
  records        ActivityRecord[]
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  @@index([organisationId, createdAt])
  @@index([uploadedBy, createdAt])
  @@map("import_batches")
}

// A supporting file (invoice, meter record, fuel log, …) that evidences one or
// more activity records of ONE subsidiary (FR §4.1). The binary lives in the
// private Supabase Storage `evidence` bucket; this row is the metadata +
// pointer (`storagePath`). Owned by a subsidiary rather than by a record, so
// one invoice uploaded once can back several records (WP8 decision 3a) — the
// links live in `activity_record_evidence`. A file never outlives its last
// link: the API deletes the row when the last one goes, and its blob through a
// `storage_intents` row committed with it (LP1-02). Written only via the
// owner/service-role backend, which enforces access and type/size/content
// validation.
model Evidence {
  id           String                   @id @default(uuid()) @db.Uuid
  subsidiaryId String                   @map("subsidiary_id") @db.Uuid
  subsidiary   Subsidiary               @relation(fields: [subsidiaryId], references: [id], onDelete: Cascade)
  // Object key in the `evidence` bucket. Unique: one object backs one file
  // row, so removing an object can never take bytes another row points at.
  storagePath  String                   @unique @map("storage_path")
  fileName     String                   @map("file_name")
  mimeType     String                   @map("mime_type")
  sizeBytes    Int                      @map("size_bytes")
  // SHA-256 of the bytes as uploaded (lowercase hex, CHECKed in the
  // database) — the file's content identity,
  // checked against Storage by `storage:reconcile --verify`. Null on files
  // uploaded before LP1-02: unverified, never back-filled with a guess.
  sha256       String?                  @db.Char(64)
  uploadedBy   String                   @map("uploaded_by") @db.Uuid
  links        ActivityRecordEvidence[]
  createdAt    DateTime                 @default(now()) @map("created_at")

  @@unique([id, subsidiaryId])
  @@index([subsidiaryId])
  @@map("evidence")
}

// One evidence file backing one activity record. Both foreign keys are
// composite over `subsidiary_id`, so a link can only join a record and a file
// of the SAME subsidiary — enforced by the database, not only by the API.
// Deleting either side removes the link; the API then deletes a file left with
// no links. Created only together with its file (an upload names the records
// it backs), so a file with no links never gains one again.
model ActivityRecordEvidence {
  activityRecordId String         @map("activity_record_id") @db.Uuid
  evidenceId       String         @map("evidence_id") @db.Uuid
  subsidiaryId     String         @map("subsidiary_id") @db.Uuid
  activityRecord   ActivityRecord @relation(fields: [activityRecordId, subsidiaryId], references: [id, subsidiaryId], onDelete: Cascade, onUpdate: NoAction)
  evidence         Evidence       @relation(fields: [evidenceId, subsidiaryId], references: [id, subsidiaryId], onDelete: Cascade, onUpdate: NoAction)
  linkedBy         String         @map("linked_by") @db.Uuid
  linkedAt         DateTime       @default(now()) @map("linked_at")

  @@id([activityRecordId, evidenceId])
  @@index([evidenceId])
  @@map("activity_record_evidence")
}

// A closed reporting period for one subsidiary (FR §4.2): while a row exists,
// NO records may be created, edited, deleted or submitted for that
// (subsidiary, year, period, periodValue) — enforced as a gate in the
// activity-records service. Locking also flips committed records to `locked`
// status (unlock reverts them to `approved`). super_admin only; every
// lock/unlock writes an audit row.
model PeriodLock {
  id              String     @id @default(uuid()) @db.Uuid
  subsidiaryId    String     @map("subsidiary_id") @db.Uuid
  subsidiary      Subsidiary @relation(fields: [subsidiaryId], references: [id], onDelete: Cascade)
  reportingYear   Int        @map("reporting_year")
  reportingPeriod String     @map("reporting_period") // 'monthly' | 'quarterly' | 'annual'
  // Same canonical vocabulary as activity_records.period_value, and for the
  // same reason: the lock is matched by exact string equality, so a lock
  // spelled differently from the records it covers closes nothing.
  periodValue     String     @map("period_value")
  lockedBy        String     @map("locked_by") @db.Uuid
  createdAt       DateTime   @default(now()) @map("created_at")

  @@unique([subsidiaryId, reportingYear, reportingPeriod, periodValue])
  @@index([subsidiaryId])
  @@map("period_locks")
}

// An emission-reduction target for one subsidiary (WP5, Targets & intensity).
// A named goal with a baseline year + absolute baseline tCO₂e and a target year
// + absolute target tCO₂e; the reduction % is derived, never stored. `scope`
// filters which emissions count ('all' | 'scope1' | 'scope2' | 'scope3'), `basis`
// records the target type. Progress is computed live from committed activity
// records (never a stored snapshot). super_admin only; every write is audited.
model Target {
  id            String     @id @default(uuid()) @db.Uuid
  subsidiaryId  String     @map("subsidiary_id") @db.Uuid
  subsidiary    Subsidiary @relation(fields: [subsidiaryId], references: [id], onDelete: Cascade)
  name          String
  basis         String // 'science_based' | 'internal_annual' | 'baseline_reduction'
  scope         String // 'all' | 'scope1' | 'scope2' | 'scope3'
  baselineYear  Int        @map("baseline_year")
  baselineTCo2e Float      @map("baseline_tco2e")
  targetYear    Int        @map("target_year")
  targetTCo2e   Float      @map("target_tco2e")
  createdBy     String     @map("created_by") @db.Uuid
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  @@index([subsidiaryId])
  @@map("targets")
}

// A configured intensity denominator for one subsidiary + year + metric (WP5).
// Intensity = emissions / denominator (e.g. tCO₂e per M EUR revenue). Kept
// per-year so intensity over time stays honest. Metric is one of the spec's four
// (emissions_page.md §2): 'area' | 'revenue' | 'headcount' | 'production_output' | 'sales_output'.
// super_admin only; every write is audited. The Intensity toggle only offers
// metrics that have a configured value for the year in view.
model SubsidiaryDenominator {
  id           String     @id @default(uuid()) @db.Uuid
  subsidiaryId String     @map("subsidiary_id") @db.Uuid
  subsidiary   Subsidiary @relation(fields: [subsidiaryId], references: [id], onDelete: Cascade)
  year         Int
  metric       String // 'area' | 'revenue' | 'headcount' | 'production_output' | 'sales_output'
  value        Float
  unit         String
  createdBy    String     @map("created_by") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@unique([subsidiaryId, year, metric])
  @@index([subsidiaryId])
  @@map("subsidiary_denominators")
}

// An explicit grant of one subsidiary to one profile — how a data_entry user
// reaches data (the other roles see their whole organisation). Both foreign
// keys are composite over `organisation_id` (LP1-03, F06), so a grant can only
// join a profile and a subsidiary of the SAME organisation, whoever writes it —
// the API, the seed, a service-role client or the owner (short of a replica-mode
// restore, which skips the keys: `runtime-role.mjs check` scans for that) — and
// a profile with no organisation can hold none. ON UPDATE NO ACTION: a profile or subsidiary
// cannot change organisation while a grant still ties it to the old one.
model UserSubsidiaryAccess {
  userId         String     @map("user_id") @db.Uuid
  subsidiaryId   String     @map("subsidiary_id") @db.Uuid
  organisationId String     @map("organisation_id") @db.Uuid
  profile        Profile    @relation(fields: [userId, organisationId], references: [id, organisationId], onDelete: Cascade, onUpdate: NoAction)
  subsidiary     Subsidiary @relation(fields: [subsidiaryId, organisationId], references: [id, organisationId], onDelete: Cascade, onUpdate: NoAction)
  createdAt      DateTime   @default(now()) @map("created_at")

  @@id([userId, subsidiaryId])
  @@index([subsidiaryId])
  @@map("user_subsidiary_access")
}

// Emission factors are REFERENCE DATA, not tenant-scoped: every authenticated
// user may read them (RLS SELECT policy has no tenant predicate). Writes stay on
// the owner/service-role backend (seed, LP4-02's loader); the runtime role
// reads only. A calculation snapshots the factor (and its release) it used, so
// historic results never change when a newer release is loaded.
//
// LP3-03: a factor belongs to exactly one release, which carries its status
// and provenance. All three factor tables are append-only in the database
// (triggers in the LP3-03 migration): a release may only be withdrawn, a factor
// or conversion never changes, and only a `fixture` release's rows may be
// deleted. The vocabularies (status, gas, basis, method, publisher) are CHECK
// constraints there, mirroring @tonyai/shared-types.
model FactorRelease {
  id               String    @id @default(uuid()) @db.Uuid
  // A closed registry (CHECK): a look-alike name cannot become a second
  // publisher. LP4-02 extends it with the real publishers.
  publisher        String
  title            String
  edition          String // the publisher's label — displayed, never compared
  ordinal          Int // orders one publisher's releases; each load exceeds the last
  status           String // authoritative | placeholder | fixture | withdrawn
  sourceUrl        String?   @map("source_url")
  licence          String?
  publishedAt      DateTime? @map("published_at") @db.Date
  gwpSet           String?   @map("gwp_set")
  // A firm or role, never a person: readable by every tenant through the API's
  // snapshots; withheld from the `authenticated` client role with `notes`.
  reviewedBy       String?   @map("reviewed_by")
  reviewedAt       DateTime? @map("reviewed_at") @db.Date
  notes            String?
  withdrawnAt      DateTime? @map("withdrawn_at") @db.Timestamptz(6)
  withdrawnBy      String?   @map("withdrawn_by")
  withdrawalReason String?   @map("withdrawal_reason")
  createdAt        DateTime  @default(now()) @map("created_at")

  factors     EmissionFactor[]
  conversions UnitConversion[]

  @@unique([publisher, ordinal])
  @@unique([publisher, edition])
  @@map("factor_releases")
}

model EmissionFactor {
  id             String   @id @default(uuid()) @db.Uuid
  releaseId      String   @map("release_id") @db.Uuid
  release        FactorRelease @relation(fields: [releaseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  category       String // canonical category key, e.g. "Electricity", "Natural Gas"
  // `factorActivityTypeFor`: the category's implicit type, a typed category's
  // fuel or gas, or `unspecified` (non-authoritative releases only).
  activityType   String   @map("activity_type")
  gas            String // CO2e (the total a calculation multiplies) | CO2 | CH4 | N2O | CO2_biogenic
  gasCoverage    String?  @map("gas_coverage") // all_ghg | co2_only on a CO2e row; NULL otherwise
  geographyCode  String   @map("geography_code") // UK | TR | EU
  reportingYear  Int      @map("reporting_year")
  dataYear       Int      @map("data_year")
  scope          Int // 1 (direct) | 2 (purchased energy)
  scope2Method   String   @map("scope2_method") // location | market | not_applicable
  calorificBasis String   @map("calorific_basis") // gross | net | not_applicable
  factorValue    Float    @map("factor_value") // kgCO2e per ONE normalized (base) unit
  factorUnit     String   @map("factor_unit") // e.g. "kgCO2e/kWh"
  normalizedUnit String   @map("normalized_unit") // the base unit of its family, e.g. "kWh"
  methodology    String // e.g. "location-based"
  source         String // provenance, e.g. "DEFRA 2024 GHG Conversion Factors"
  version        String // the release's edition when loaded (pre-LP3-03 rows keep their own)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // FACTOR_IDENTITY_FIELDS (@tonyai/shared-types), in its order.
  @@unique([releaseId, category, activityType, gas, geographyCode, reportingYear, scope2Method, calorificBasis, normalizedUnit], name: "identity", map: "emission_factors_identity_key")
  @@index([category, geographyCode, reportingYear])
  @@map("emission_factors")
}

// The factor library's own record (LP3-03): every load, withdrawal and fixture
// deletion, written by database triggers for every writer — the seed, the e2e
// suite, LP4-02's loader, an operator — since no release is written through
// the API. Global, not per tenant (unlike `audit_log`); append-only; no client
// role reads it; the runtime reads only.
model FactorReleaseEvent {
  id            String   @id @default(uuid()) @db.Uuid
  releaseId     String   @map("release_id") @db.Uuid // no FK: a deleted fixture release keeps its record
  publisher     String
  edition       String
  releaseStatus String   @map("release_status") // the release's status at the event
  event         String // loaded | rows_added | withdrawn | rows_deleted | deleted
  tableName     String?  @map("table_name") // rows_added / rows_deleted: which table
  rowCount      Int?     @map("row_count")
  detail        Json? // withdrawn: who, when, why
  dbRole        String   @map("db_role") // the database role that wrote it
  actor         String? // `tonyai.actor`, when the writer stated one (a firm or role)
  occurredAt    DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@index([releaseId, occurredAt])
  @@map("factor_release_events")
}

// A sourced step between unit families (metered m³ → kWh) for one fuel,
// country and year. A definitional step (MWh → kWh, tonnes → kg) is code, not a
// row.
model UnitConversion {
  id                  String        @id @default(uuid()) @db.Uuid
  releaseId           String        @map("release_id") @db.Uuid
  release             FactorRelease @relation(fields: [releaseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  category            String
  activityType        String        @map("activity_type")
  geographyCode       String        @map("geography_code")
  reportingYear       Int           @map("reporting_year")
  dataYear            Int           @map("data_year")
  fromUnit            String        @map("from_unit") // a base unit (DIMENSION_BASE_UNIT)
  toUnit              String        @map("to_unit") // a base unit of another family
  multiplier          Float
  calorificBasis      String        @map("calorific_basis")
  referenceConditions String?       @map("reference_conditions")
  basis               String
  createdAt           DateTime      @default(now()) @map("created_at")

  // CONVERSION_IDENTITY_FIELDS (@tonyai/shared-types), in its order.
  @@unique([releaseId, category, activityType, geographyCode, reportingYear, fromUnit, toUnit, calorificBasis], name: "identity", map: "unit_conversions_identity_key")
  @@index([category, geographyCode, reportingYear])
  @@map("unit_conversions")
}

model AuditLog {
  id     String  @id @default(uuid()) @db.Uuid
  userId String? @map("user_id") @db.Uuid
  // The actor's role AT THE TIME of the action — denormalised on purpose: roles
  // change, and an audit trail that renders today's role next to a year-old
  // action would misstate who was allowed to do what. Null on rows written
  // before this column existed (never back-dated with a guess).
  role   String?
  // Tenant scope, denormalised from the ACTOR's profile rather than joined from
  // the entity: `report` rows carry a null entityId, and `delete` rows point at
  // a row that no longer exists — neither can be joined. This column is what
  // makes tenant-scoped audit reads possible for every entity.
  organisationId String? @map("organisation_id") @db.Uuid
  // Deliberately TEXT, not an enum — for the same reason as `role` above: a
  // historical record must be able to hold a verb that has since been retired,
  // and a PG enum makes retiring one a migration. The current taxonomy is
  // AUDIT_ACTIONS / AUDIT_ENTITIES in @tonyai/shared-types.
  action         String
  entity         String // e.g. "subsidiary"
  entityId       String? @map("entity_id")
  diff           Json?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([entity, entityId])
  // The viewer lists newest-first, scoped to one organisation.
  @@index([organisationId, createdAt])
  @@map("audit_log")
}

enum StorageIntentKind {
  // An upload in flight: the object may exist, the row that will own it is
  // not committed yet. Adopted (deleted) by that row's transaction.
  upload
  // The object must go: its row was deleted, or its upload was abandoned.
  delete

  @@map("storage_intent_kind")
}

// A Storage effect the database has committed to and Storage has not carried
// out yet (LP1-02, F14). Storage is a second system with no transaction of its
// own, so every object an API path writes or removes is named here FIRST:
//  - an upload writes an `upload` intent and commits it before sending the
//    bytes; the transaction that writes the owning row deletes it. One left
//    behind is an upload whose row never committed — its object is removed.
//  - a delete writes a `delete` intent in the SAME transaction as the row
//    delete and its audit row; the object is removed after the commit, and the
//    intent goes when Storage confirms.
// A failure at any boundary therefore leaves a row here, retried with backoff
// by the API's sweeper (`StorageIntentsService`), never a silent orphan or a
// row pointing at bytes that are gone. Operational state, not tenant data:
// RLS is enabled with no policy and nothing is granted to client roles.
model StorageIntent {
  id             String            @id @default(uuid()) @db.Uuid
  kind           StorageIntentKind
  bucket         String
  objectPath     String            @map("object_path")
  // What wrote it, e.g. `evidence.upload`, `evidence.delete` — for operators.
  reason         String
  organisationId String?           @map("organisation_id") @db.Uuid
  subsidiaryId   String?           @map("subsidiary_id") @db.Uuid
  attempts       Int               @default(0)
  lastError      String?           @map("last_error")
  // Every time here is the DATABASE's: the sweeper compares them with now()
  // in SQL. So timestamptz(6), unlike the rest of the schema (no session time
  // zone, no rounding past the next statement's now()), and defaults the
  // database fills — Prisma's `@default(now())` is filled by the query engine
  // from the API host's clock, and a host a few ms ahead made an intent
  // written a moment ago read as not yet due (measured, LP1-02). Spelled
  // transaction_timestamp() — the same value as now() — because Prisma reads
  // a database default of now() as its own and reports drift on every diff.
  nextAttemptAt  DateTime          @default(dbgenerated("transaction_timestamp()")) @map("next_attempt_at") @db.Timestamptz(6)
  // A lease, not a lock: set while one process removes the object, so a
  // second sweeper skips it without a transaction held across the HTTP call.
  claimedUntil   DateTime?         @map("claimed_until") @db.Timestamptz(6)
  createdAt      DateTime          @default(dbgenerated("transaction_timestamp()")) @map("created_at") @db.Timestamptz(6)

  @@unique([bucket, objectPath])
  @@index([kind, nextAttemptAt])
  @@map("storage_intents")
}
