// TonyAI — Prisma schema (Milestone 1 vertical slice)
// Tables live in the Postgres `public` schema; Supabase Auth owns `auth.users`.
// Profile.id mirrors auth.users.id (no cross-schema FK in Prisma).

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
  // Container targets: debian (amd64) + arm64 for Apple-Silicon local builds.
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  super_admin
  consultant
  data_entry
  executive_viewer
}

enum SubsidiaryStatus {
  active
  inactive
  pending
}

/// How completeness is measured for a subsidiary (WP17 / round-1 DE-2 + DASH-3).
///
/// `subsidiary` — the historic behaviour: a category is complete once it holds a
/// committed record with its evidence, whatever the entity that record names.
/// `location`  — the invoice rule: each invoice-tracked category needs one
/// monthly invoice per LOCATION, so the denominator is `locations × 12`.
///
/// An explicit setting rather than an inference. Measured before choosing: 96 of
/// the 102 seeded records carry no `location_id` at all, so a rule that switched
/// itself on whenever a subsidiary happens to own locations would report almost
/// every existing tenant as incomplete overnight, and would leave the user with
/// no way to see WHY. Defaulting to `subsidiary` keeps every existing dashboard
/// exactly as it was; a super_admin will opt a subsidiary in when its data is
/// actually keyed by location (API: PATCH /subsidiaries/:id — the UI arrives
/// with the coverage display in WP17 PR 3).
enum TrackingGranularity {
  subsidiary
  location
}

enum ActivityRecordStatus {
  draft
  submitted
  under_review
  approved
  rejected
  locked
  // An approved figure withdrawn from the inventory, with a mandatory reason,
  // WITHOUT deleting it. Before this, `approved` had no exit at all: the only
  // remedy was deleting the row, which the API rightly refuses and which would
  // destroy the figure a reviewer accepted. A voided record still exists, is
  // still auditable, and counts towards nothing.
  //
  // This carries the four elements FR §4.3 lists for a revision entry
  // (mandatory comment, user reference, timestamp, original-value visibility)
  // but it does NOT implement §4.3, which governs LOCKED records — those are
  // refused here and still reopen only by unlocking the period. §4.3 also asks
  // for a revision ENTRY linked to what it corrects; there is no such link yet,
  // so a restatement is two unrelated rows.
  voided
}

model Profile {
  id               String                 @id @db.Uuid // = auth.users.id
  email            String                 @unique
  fullName         String                 @map("full_name")
  role             UserRole               @default(data_entry)
  language         String                 @default("en")
  theme            String                 @default("light")
  organisationId   String?                @map("organisation_id") @db.Uuid
  organisation     Organisation?          @relation(fields: [organisationId], references: [id])
  subsidiaryAccess UserSubsidiaryAccess[]
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  @@map("profiles")
}

model Organisation {
  id                String       @id @default(uuid()) @db.Uuid
  legalName         String       @map("legal_name")
  tradingName       String?      @map("trading_name")
  country           String
  geographyCode     String       @map("geography_code")
  sector            String?
  reportingCurrency String       @default("EUR") @map("reporting_currency")
  subsidiaries      Subsidiary[]
  profiles          Profile[]
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  @@map("organisations")
}

model Subsidiary {
  id               String                 @id @default(uuid()) @db.Uuid
  organisationId   String                 @map("organisation_id") @db.Uuid
  organisation     Organisation           @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  legalName        String                 @map("legal_name")
  tradingName      String?                @map("trading_name")
  location         String?
  geographyCode    String                 @map("geography_code")
  businessArea     String?                @map("business_area")
  sector           String?
  // Who to contact about this entity's reporting (round-1 UAT SUB-2). Nullable:
  // every existing row predates them, and a subsidiary is legally identifiable
  // without them. `designatedPerson` is the NAME and already existed — it is
  // rendered read-only as "responsible" in the tracking matrix — but until WP16
  // nothing could write it, so all five seeded rows say "Seed Admin".
  designatedPerson String?                @map("designated_person")
  contactEmail     String?                @map("contact_email")
  contactPhone     String?                @map("contact_phone")
  reportingStatus  SubsidiaryStatus       @default(pending) @map("reporting_status")
  includedScopes   Int[]                  @default([1, 2]) @map("included_scopes")
  // Defaults to `subsidiary` so no existing row changes meaning. Both write
  // paths refuse `location` without at least one location: the denominator
  // would be `0 × 12 = 0`, every slot is then vacuously covered, and a
  // subsidiary holding one stray record would read as complete.
  trackingGranularity TrackingGranularity @default(subsidiary) @map("tracking_granularity")
  locations        Location[]
  access           UserSubsidiaryAccess[]
  activityRecords  ActivityRecord[]
  periodLocks      PeriodLock[]
  targets          Target[]
  denominators     SubsidiaryDenominator[]
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  @@index([organisationId])
  @@map("subsidiaries")
}

model Location {
  id               String           @id @default(uuid()) @db.Uuid
  subsidiaryId     String           @map("subsidiary_id") @db.Uuid
  subsidiary       Subsidiary       @relation(fields: [subsidiaryId], references: [id], onDelete: Cascade)
  name             String
  geographyCode    String           @map("geography_code") // drives factor selection for records at this location
  address          String?
  authorizedPerson String?          @map("authorized_person")
  activityRecords  ActivityRecord[]
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  @@index([subsidiaryId])
  @@map("locations")
}

// An activity record is the core data-entry unit: a single activity input for a
// (subsidiary, reporting period, category), plus an IMMUTABLE calculation
// snapshot produced by the calc engine at create/update time (never recomputed
// on read, so historic results survive factor-library changes). It moves through
// a status workflow (draft -> submitted -> under_review -> approved/rejected).
// `approved` is immutable and leaves only by being VOIDED — an audited
// withdrawal that takes a figure out of the inventory with a stated reason
// instead of deleting it. `locked` leaves only by UNLOCKING the period, and a
// void is refused on it: a closed period reopens through its own path or not at
// all. Child of `subsidiaries`, so it is tenant-scoped by `subsidiary_id`.
model ActivityRecord {
  id             String               @id @default(uuid()) @db.Uuid
  subsidiaryId   String               @map("subsidiary_id") @db.Uuid
  subsidiary     Subsidiary           @relation(fields: [subsidiaryId], references: [id], onDelete: Cascade)
  locationId     String?              @map("location_id") @db.Uuid
  location       Location?            @relation(fields: [locationId], references: [id], onDelete: SetNull)
  reportingYear  Int                  @map("reporting_year")
  reportingPeriod String              @map("reporting_period") // 'monthly' | 'quarterly' | 'annual'
  periodValue    String               @map("period_value") // e.g. "Q1", "January", "Annual"
  category       String // canonical category key, e.g. "Electricity"
  scope          Int // derived from CATEGORY_SCOPE_MAP
  status         ActivityRecordStatus @default(draft)
  activityValue  Float                @map("activity_value")
  activityUnit   String               @map("activity_unit")
  input          Json? // raw structured input as submitted (optional)
  calculation    Json // immutable calc-engine snapshot (tCo2e + factor traceability)
  createdBy      String               @map("created_by") @db.Uuid
  anomalyFlag    Boolean              @default(false) @map("anomaly_flag")
  // The AUTHOR's justification for an anomalous value (VAR §4). A reviewer must
  // never overwrite it — their own words go in reviewNote.
  varianceReason String?              @map("variance_reason")
  // Review outcome: who acted, when, and why (a rejection reason is mandatory).
  reviewedBy     String?              @map("reviewed_by") @db.Uuid
  reviewedAt     DateTime?            @map("reviewed_at")
  reviewNote     String?              @map("review_note")
  // Who withdrew this figure, when, and why. Separate from
  // `reviewNote` on purpose — that is a reviewer's verdict on data still in the
  // inventory, this is the record of taking data OUT of it, and conflating them
  // would let a rejection reason read as a restatement.
  voidReason     String?              @map("void_reason")
  voidedBy       String?              @map("voided_by") @db.Uuid
  voidedAt       DateTime?            @map("voided_at")
  evidence       Evidence[]
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  // Uniqueness is enforced by a raw NULLS NOT DISTINCT unique index (see the
  // record_location_linkage migration): one record per (subsidiary, location,
  // year, period, periodValue, category) — NULL location_id (subsidiary-level)
  // rows are deduplicated too. Prisma's @@unique can't express NULLS NOT
  // DISTINCT, so it lives in raw SQL like the RLS policies.
  @@index([subsidiaryId])
  @@index([locationId])
  @@map("activity_records")
}

// A supporting file (invoice, meter record, fuel log, …) linked to an activity
// record (FR §4.1). The binary lives in the private Supabase Storage `evidence`
// bucket; this row is the metadata + pointer (`storagePath`). Tenant-scoped
// through its parent activity record's subsidiary. Uploaded/removed only via the
// owner/service-role backend, which also enforces access + type/size validation.
model Evidence {
  id               String         @id @default(uuid()) @db.Uuid
  activityRecordId String         @map("activity_record_id") @db.Uuid
  activityRecord   ActivityRecord @relation(fields: [activityRecordId], references: [id], onDelete: Cascade)
  storagePath      String         @map("storage_path") // object key in the `evidence` bucket
  fileName         String         @map("file_name")
  mimeType         String         @map("mime_type")
  sizeBytes        Int            @map("size_bytes")
  uploadedBy       String         @map("uploaded_by") @db.Uuid
  createdAt        DateTime       @default(now()) @map("created_at")

  @@index([activityRecordId])
  @@map("evidence")
}

// A closed reporting period for one subsidiary (FR §4.2): while a row exists,
// NO records may be created, edited, deleted or submitted for that
// (subsidiary, year, period, periodValue) — enforced as a gate in the
// activity-records service. Locking also flips committed records to `locked`
// status (unlock reverts them to `approved`). super_admin only; every
// lock/unlock writes an audit row.
model PeriodLock {
  id              String     @id @default(uuid()) @db.Uuid
  subsidiaryId    String     @map("subsidiary_id") @db.Uuid
  subsidiary      Subsidiary @relation(fields: [subsidiaryId], references: [id], onDelete: Cascade)
  reportingYear   Int        @map("reporting_year")
  reportingPeriod String     @map("reporting_period") // 'monthly' | 'quarterly' | 'annual'
  periodValue     String     @map("period_value") // e.g. "Q1", "January", "Annual"
  lockedBy        String     @map("locked_by") @db.Uuid
  createdAt       DateTime   @default(now()) @map("created_at")

  @@unique([subsidiaryId, reportingYear, reportingPeriod, periodValue])
  @@index([subsidiaryId])
  @@map("period_locks")
}

// An emission-reduction target for one subsidiary (WP5, Targets & intensity).
// A named goal with a baseline year + absolute baseline tCO₂e and a target year
// + absolute target tCO₂e; the reduction % is derived, never stored. `scope`
// filters which emissions count ('all' | 'scope1' | 'scope2' | 'scope3'), `basis`
// records the target type. Progress is computed live from committed activity
// records (never a stored snapshot). super_admin only; every write is audited.
model Target {
  id            String     @id @default(uuid()) @db.Uuid
  subsidiaryId  String     @map("subsidiary_id") @db.Uuid
  subsidiary    Subsidiary @relation(fields: [subsidiaryId], references: [id], onDelete: Cascade)
  name          String
  basis         String // 'science_based' | 'internal_annual' | 'baseline_reduction'
  scope         String // 'all' | 'scope1' | 'scope2' | 'scope3'
  baselineYear  Int        @map("baseline_year")
  baselineTCo2e Float      @map("baseline_tco2e")
  targetYear    Int        @map("target_year")
  targetTCo2e   Float      @map("target_tco2e")
  createdBy     String     @map("created_by") @db.Uuid
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  @@index([subsidiaryId])
  @@map("targets")
}

// A configured intensity denominator for one subsidiary + year + metric (WP5).
// Intensity = emissions / denominator (e.g. tCO₂e per M EUR revenue). Kept
// per-year so intensity over time stays honest. Metric is one of the spec's four
// (emissions_page.md §2): 'area' | 'revenue' | 'headcount' | 'production_output' | 'sales_output'.
// super_admin only; every write is audited. The Intensity toggle only offers
// metrics that have a configured value for the year in view.
model SubsidiaryDenominator {
  id           String     @id @default(uuid()) @db.Uuid
  subsidiaryId String     @map("subsidiary_id") @db.Uuid
  subsidiary   Subsidiary @relation(fields: [subsidiaryId], references: [id], onDelete: Cascade)
  year         Int
  metric       String // 'area' | 'revenue' | 'headcount' | 'production_output' | 'sales_output'
  value        Float
  unit         String
  createdBy    String     @map("created_by") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@unique([subsidiaryId, year, metric])
  @@index([subsidiaryId])
  @@map("subsidiary_denominators")
}

model UserSubsidiaryAccess {
  userId       String     @map("user_id") @db.Uuid
  subsidiaryId String     @map("subsidiary_id") @db.Uuid
  profile      Profile    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subsidiary   Subsidiary @relation(fields: [subsidiaryId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now()) @map("created_at")

  @@id([userId, subsidiaryId])
  @@map("user_subsidiary_access")
}

// Emission factors are REFERENCE DATA, not tenant-scoped: every authenticated
// user may read them (RLS SELECT policy has no tenant predicate). Writes stay on
// the owner/service-role backend (seed). A calculation snapshots the factor it
// used so historic results never change even if a newer version is added later.
model EmissionFactor {
  id             String   @id @default(uuid()) @db.Uuid
  category       String // canonical category key, e.g. "Electricity", "Natural Gas"
  geographyCode  String   @map("geography_code") // UK | TR | EU
  reportingYear  Int      @map("reporting_year")
  scope          Int // 1 (direct) | 2 (purchased energy)
  factorValue    Float    @map("factor_value") // kgCO2e per normalized unit
  factorUnit     String   @map("factor_unit") // e.g. "kgCO2e/kWh"
  normalizedUnit String   @map("normalized_unit") // target unit after normalization, e.g. "kWh"
  methodology    String // e.g. "location-based"
  source         String // provenance, e.g. "DEFRA 2024 GHG Conversion Factors"
  version        String // factor-library version, e.g. "2024.1"
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([category, geographyCode, reportingYear, version])
  @@index([category, geographyCode, reportingYear])
  @@map("emission_factors")
}

model AuditLog {
  id     String  @id @default(uuid()) @db.Uuid
  userId String? @map("user_id") @db.Uuid
  // The actor's role AT THE TIME of the action — denormalised on purpose: roles
  // change, and an audit trail that renders today's role next to a year-old
  // action would misstate who was allowed to do what. Null on rows written
  // before this column existed (never back-dated with a guess).
  role   String?
  // Tenant scope, denormalised from the ACTOR's profile rather than joined from
  // the entity: `report` rows carry a null entityId, and `delete` rows point at
  // a row that no longer exists — neither can be joined. This column is what
  // makes tenant-scoped audit reads possible for every entity.
  organisationId String? @map("organisation_id") @db.Uuid
  // Deliberately TEXT, not an enum — for the same reason as `role` above: a
  // historical record must be able to hold a verb that has since been retired,
  // and a PG enum makes retiring one a migration. The current taxonomy is
  // AUDIT_ACTIONS / AUDIT_ENTITIES in @tonyai/shared-types.
  action         String
  entity         String // e.g. "subsidiary"
  entityId       String? @map("entity_id")
  diff           Json?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([entity, entityId])
  // The viewer lists newest-first, scoped to one organisation.
  @@index([organisationId, createdAt])
  @@map("audit_log")
}
