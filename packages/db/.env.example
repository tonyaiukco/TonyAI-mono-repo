# Local Supabase (defaults printed by `supabase start`)
# Two credentials (LP1-03). DATABASE_URL is the least-privileged runtime role
# the API and its tools use; DIRECT_URL is the owner, for migrations, the seed
# and DDL only. `pnpm setup` generates the runtime password and sets it; copying
# this file by hand, choose one and run
#   DIRECT_URL=<owner url> RUNTIME_DB_PASSWORD=<it> node packages/db/scripts/runtime-role.mjs provision
DATABASE_URL="postgresql://tonyai_runtime:<generated-by-pnpm-setup>@127.0.0.1:54322/postgres"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# Used by prisma/seed.ts to create auth users via the Supabase Admin API
SUPABASE_URL="http://127.0.0.1:54321"
