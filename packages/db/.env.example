# Local Supabase (defaults printed by `supabase start`)
# Two credentials (LP1-03). DATABASE_URL is the least-privileged runtime role
# the API and its tools use (`pnpm setup` gives it this local password); DIRECT_URL
# is the owner, for migrations, the seed and DDL only.
DATABASE_URL="postgresql://tonyai_runtime:tonyai-runtime-local@127.0.0.1:54322/postgres"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# Used by prisma/seed.ts to create auth users via the Supabase Admin API
