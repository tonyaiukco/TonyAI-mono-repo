{
  "name": "@tonyai/db",
  "version": "0.0.0",
  "private": true,
  "main": "./generated/client/index.js",
  "types": "./generated/client/index.d.ts",
  "scripts": {
    "build": "prisma generate",
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "deploy": "prisma migrate deploy",
    "reset": "prisma migrate reset --force && node scripts/reclaim-evidence.mjs --apply --older-than=0",
    "seed": "tsx prisma/seed.ts",
    "studio": "prisma studio",
    "lint": "echo \"(db) no lint\" && exit 0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "evidence:reclaim": "node scripts/reclaim-evidence.mjs",
    "anomaly:probe": "node scripts/anomaly-probe.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "@tonyai/shared-types": "workspace:*"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "@types/node": "^22",
    "dotenv": "^16.4.7",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "5.7.3"
  }
}
