# CLOUD REFERENCE ONLY: do not source or copy this file into app directories.
# Local setup retains the per-package examples. Follow infra/README.md for staging.
# Placeholders describe Key Vault bindings; these are NOT runnable credentials.
NODE_ENV=production
PORT=3001
LOG_FORMAT=json
SUPABASE_URL=https://<SUPABASE_PROJECT_REF>.supabase.co
SUPABASE_JWT_SCHEME=jwks
WEB_ORIGIN=https://<STAGING_WEB_FQDN>
DATABASE_URL=<KEY_VAULT_REFERENCE:database-url>
# DATABASE_URL = runtime role (tonyai_runtime.<project-ref>).
# DIRECT_URL = owner (postgres.<project-ref>), for migrations and seed only.
# Do not inject DIRECT_URL into application containers.
DIRECT_URL=<KEY_VAULT_REFERENCE:direct-url>
SUPABASE_SERVICE_ROLE_KEY=<KEY_VAULT_REFERENCE:supabase-service-role-key>
# Owner-run migrations resolve DIRECT_URL from Key Vault secret direct-url instead.
# Both vault URLs require sslaccept=strict and sslcert=/app/infra/certs/prod-ca-2021.crt.
# Hosts must be aws-N-eu-central-1.pooler.supabase.com; credentials stay in Key Vault.
# Pooler transaction port 6543 for runtime, session port 5432 for migrations.
# Omit SUPABASE_JWT_SECRET and ALLOW_INSECURE_LOCAL_AUTH in cloud.

# Web build inputs: only the project's public browser key belongs in this bundle.
NEXT_PUBLIC_SUPABASE_URL=https://<SUPABASE_PROJECT_REF>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<PUBLIC_BROWSER_KEY_FROM_SUPABASE>
NEXT_PUBLIC_API_BASE_URL=https://<STAGING_API_FQDN>/api/v1
# Web server runtime: same hosted URL, no local/container override.
SUPABASE_URL_INTERNAL=https://<SUPABASE_PROJECT_REF>.supabase.co

# Terraform inputs: infra/config/*.example.json contain nonsecret placeholders only.
# Never use TF_VAR_* for secret values or copy credentials into tfvars/state/plans.
# Owner recovery journals and versioned release manifests live under .infra-local/.
