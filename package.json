{
  "name": "tonyai",
  "version": "0.0.0",
  "private": true,
  "description": "TonyAI — Enterprise carbon accounting / ESG SaaS (monorepo)",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "setup": "bash scripts/bootstrap.sh",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "turbo run typecheck && pnpm typecheck:e2e",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "test": "turbo run test",
    "e2e": "pnpm --filter @tonyai/api build && playwright test",
    "e2e:ui": "playwright test --ui",
    "rls:probe": "node scripts/rls-probes.mjs",
    "db:generate": "pnpm --filter @tonyai/db run generate",
    "db:migrate": "pnpm --filter @tonyai/db run migrate",
    "db:deploy": "pnpm --filter @tonyai/db run deploy",
    "db:seed": "pnpm --filter @tonyai/db run seed",
    "db:reset": "pnpm --filter @tonyai/db run reset && pnpm storage:reconcile --reclaim-orphans --older-than=0 --apply",
    "storage:reconcile": "pnpm --filter @tonyai/api build && pnpm --filter @tonyai/api run storage:reconcile",
    "anomaly:probe": "pnpm --filter @tonyai/db run anomaly:probe",
    "anomaly:recompute": "pnpm --filter @tonyai/db run anomaly:recompute",
    "docker:up": "bash scripts/compose-dev.sh up --build -d",
    "docker:down": "bash scripts/compose-dev.sh down"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@tonyai/shared-types": "workspace:*",
    "@types/node": "^22",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "exceljs": "^4.4.0",
    "globals": "^17.11.0",
    "turbo": "^2.3.3",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.68.0"
  },
  "engines": {
    "node": ">=20"
  }
}
