// TonyAI R3 private DB candidate: a model-free Prisma Client, used only for the candidate's raw SQL
// against its isolated container. Generated at this fixed absolute path, and only for the hosted
// runner's engine target, so that every generated byte is host-independent and can be pinned.
generator client {
  provider      = "prisma-client-js"
  output        = "/private/tmp/tonyai-r3-db/client"
  binaryTargets = ["debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
