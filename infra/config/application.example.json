{
  "foundation": {
    "subscription_id": "<subscription-uuid>",
    "tenant_id": "<tenant-uuid>",
    "environment": "staging",
    "resource_group": "tonyai-qatmp-apps",
    "prefix": "tonyaiqt",
    "registry_name": "<registry-from-foundation>",
    "vault_name": "<vault-from-foundation>",
    "default_domain": "<environment-domain>.swedencentral.azurecontainerapps.io"
  },
  "release": {
    "source_sha": "<image-source-commit-sha>",
    "release_id": "r001",
    "supabase_project_ref": "<20-letter-project-ref>",
    "api_digest": "sha256:<64-lowercase-hex>",
    "web_digest": "sha256:<64-lowercase-hex>",
    "database_secret_version": "<32-lowercase-hex>",
    "backend_secret_version": "<32-lowercase-hex>",
    "storage_cleanup_hold": true,
    "storage_sweep_interval_seconds": 300,
    "mail": {
      "host": "smtp.azurecomm.net",
      "port": 587,
      "secure": false,
      "user": "<ACS SMTP Username>",
      "from": "<ACS sender address>",
      "password_secret_version": "<32-lowercase-hex>"
    }
  }
}
