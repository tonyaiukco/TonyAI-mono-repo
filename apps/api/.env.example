# API server
PORT=3001
WEB_ORIGIN="http://localhost:3000"

# Local Supabase (defaults printed by `supabase start`)
# Two credentials (LP1-03). DATABASE_URL is the least-privileged runtime role
# the API and its tools use; DIRECT_URL is the owner, for migrations, the seed
# and DDL only. `pnpm setup` generates the runtime password and sets it; copying
# this file by hand, choose one and run (the prompt keeps it out of shell history)
#   read -rs RUNTIME_DB_PASSWORD && export RUNTIME_DB_PASSWORD
#   DIRECT_URL=<owner url> node packages/db/scripts/runtime-role.mjs provision
DATABASE_URL="postgresql://tonyai_runtime:<generated-by-pnpm-setup>@127.0.0.1:54322/postgres"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
# Also the JWKS origin: projects that sign tokens asymmetrically are verified
# against <SUPABASE_URL>/auth/v1/.well-known/jwks.json.
SUPABASE_URL="http://127.0.0.1:54321"
# Only used by projects still signing with the legacy shared HS256 secret.
# WARNING: the value below is the PUBLIC default of every local Supabase — it is
# fine locally and catastrophic anywhere else (anyone could forge a super_admin
# token). The API refuses to boot with it unless ALLOW_INSECURE_LOCAL_AUTH=true
# AND SUPABASE_URL is a loopback host.
SUPABASE_JWT_SECRET="super-secret-jwt-token-with-at-least-32-characters-long"

# Which signing scheme is accepted: hs256 | jwks | auto.
# `auto` accepts both and exists for local dev, where the supabase-cli version
# decides the scheme. It MUST be pinned anywhere else — while `auto` is on, a
# leaked legacy secret still mints valid tokens even after the project has moved
# to asymmetric keys.
SUPABASE_JWT_SCHEME="auto"

# LOCAL DEVELOPMENT ONLY. Relaxes the two rules above, and only in combination
# with a loopback SUPABASE_URL. Never set this in a deployed environment — the
# boot-time check is what stops a copied .env from serving real tenant data with
# a public secret. NODE_ENV is deliberately NOT used for this: the container
# image sets NODE_ENV=production locally, and a plain `node dist/main.js`
# deployment sets nothing at all.
ALLOW_INSECURE_LOCAL_AUTH=true

# LOCAL DEVELOPMENT AND CI ONLY (LP3-03, owner decision K3). Lets the API
# calculate from non-authoritative factor releases — the seed's placeholder
# library and a test run's fixtures. Only the exact string `true` turns it on;
# the API refuses to boot with it unless DATABASE_URL and SUPABASE_URL are both
# set and loopback, and logs the policy at every boot (`factor_policy`).
# Staging and production never set it: they calculate from authoritative
# releases only, and refuse a record no authoritative factor covers
# (`placeholder_refused`).
ALLOW_PLACEHOLDER_FACTORS=true

# Audience claim required on access tokens. Only set this if the project
# overrides GOTRUE_JWT_AUD; the default matches stock Supabase.
# SUPABASE_JWT_AUDIENCE="authenticated"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoic3VwYWJhc2UtZGVtbyIsImlhdCI6MTY0MTc2OTIwMCwiZXhwIjoxNzk5NTM1NjAwfQ.DaYlNEoUrrEn2Ig7tqibS-PHK5vgusbcbo7X36XVt4Q"

# Observability (all optional — absent = disabled)
# LOG_FORMAT=json|pretty  (default: pretty in dev, json in production)
# SENTRY_DSN=""                 # error reporting; unset = Sentry never initialises
# SENTRY_ENVIRONMENT="local"
# SENTRY_TRACES_SAMPLE_RATE="0"

# Storage recovery (LP1-02; both optional)
# STORAGE_SWEEP_INTERVAL_SECONDS="300"  # how often the in-process sweeper retries pending Storage intents; 0 = off
# STORAGE_CLEANUP_HOLD="1"              # set while a backup or restore runs: nothing removes bytes until it is unset
